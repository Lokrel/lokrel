	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Found %ld source group spread across different folders. Review a plan to bring each group into one folder. Virtual groups are already available.</string>
			<key>other</key>
			<string>Found %ld source groups spread across different folders. Review a plan to bring each group into one folder. Virtual groups are already available.</string>
		</dict>
	</dict>
	<key>Model Files (%ld)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Model File (%ld)</string>
			<key>other</key>
			<string>Model Files (%ld)</string>
		</dict>
	</dict>
	<key>Move %ld Models to Trash?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
